# Supabase Connect -> Connection string -> Transaction pooler.
# This must be a PostgreSQL URI, not an sb_secret_ API key.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

GROQ_API_KEY=
MAGIC_HOUR_API_KEY=

# Required for Manus-backed uploads and media helpers.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
