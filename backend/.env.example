# Groq (script/storyboard generation)
# Recommended: point at your own Cloudflare Worker proxy so the raw Groq key
# never sits in this backend's env (same pattern as your other projects).
GROQ_PROXY_URL=https://groq-proxy.chowdoryrintu.workers.dev
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Video generation - any Kling-compatible async gateway
# (official Kling API, or a pay-as-you-go gateway like fal.ai / Renderful / Evolink)
KLING_API_BASE_URL=https://api.evolink.ai/v1
KLING_API_KEY=
KLING_MODEL=kling-v3-text-to-video

# CORS
ALLOWED_ORIGINS=http://localhost:3000
