# =====================================================
# AI Video Generator — Environment Configuration
# =====================================================
# All API keys below are FREE — no credit card required.
# =====================================================

# --- Groq (storyboard generation, free open-source Llama models) ---
# Get a free API key at https://console.groq.com/keys
# Option A (recommended): set GROQ_API_KEY and call Groq directly
# Option B: set GROQ_PROXY_URL to your own proxy so the key stays server-side
GROQ_PROXY_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Video generation (Magic Hour API, free tier) ---
# Get a free API key at https://magichour.ai/developer
# Free tier: limited to 576px resolution, no credit card needed
KLING_API_BASE_URL=https://api.magichour.ai/v1
KLING_API_KEY=
KLING_MODEL=kling-3.0
KLING_RESOLUTION=480p

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
