# --- Storyboard generation (Groq) ---
# Prefer a server-side proxy in production so the Groq key stays isolated.
GROQ_PROXY_URL=
# Only needed when GROQ_PROXY_URL is empty.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# --- Media generation (Magic Hour) ---
# Create a key in https://magichour.ai/developer. Keep it only in this backend
# .env file; never put it in NEXT_PUBLIC_* variables or browser code.
MAGIC_HOUR_API_BASE_URL=https://api.magichour.ai/v1
MAGIC_HOUR_API_KEY=

# The application presents validated model and resolution choices. Its default
# is LTX 2.3 at 480p, which is a free-tier-safe starting point.

# Limits for image-to-video uploads through this backend.
MAX_IMAGE_UPLOAD_BYTES=10485760
ASSET_TTL_SECONDS=3600

# Comma-separated front-end origins permitted to call this API.
ALLOWED_ORIGINS=http://localhost:3000
